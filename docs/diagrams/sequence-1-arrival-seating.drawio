        </mxCell>
        <mxCell id="c268" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d9b74a;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10.5;fontColor=#4b4b3c;fontFamily=Helvetica;" value="&lt;b style=&quot;color:#8a6a00&quot;&gt;POLYMORPHISM&lt;/b&gt;&lt;br&gt;Game never asks a customer&amp;#x27;s type. Loss rate, food choice, bill and paying remark are dispatched to the subclass (Stage 2)." vertex="1">
          <mxGeometry height="82" width="222" x="290" y="1545" as="geometry" />
        </mxCell>
        <mxCell id="e269" edge="1" parent="1" source="c268" style="endArrow=none;dashed=1;dashPattern=3 3;html=1;strokeColor=#d9b74a;entryX=0;entryY=0.4;entryDx=0;entryDy=0;entryPerimeter=0;" target="c120" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c270" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d9b74a;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10.5;fontColor=#4b4b3c;fontFamily=Helvetica;" value="&lt;b style=&quot;color:#8a6a00&quot;&gt;ENCAPSULATION + COMPOSITION&lt;/b&gt;&lt;br&gt;Restaurant owns its tables and orders and is the only object that moves a customer between queue, table and door (the ~ methods). Its lists are handed out read-only." vertex="1">
          <mxGeometry height="82" width="310" x="690" y="1272" as="geometry" />
        </mxCell>
        <mxCell id="e271" edge="1" parent="1" source="c270" style="endArrow=none;dashed=1;dashPattern=3 3;html=1;strokeColor=#d9b74a;entryX=1;entryY=0.85;entryDx=0;entryDy=0;entryPerimeter=0;" target="c112" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c272" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d9b74a;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10.5;fontColor=#4b4b3c;fontFamily=Helvetica;" value="&lt;b style=&quot;color:#8a6a00&quot;&gt;TEMPLATE METHOD&lt;/b&gt;&lt;br&gt;perform() checks the task budget and duty, then calls carryOut(). A broken rule throws RuleViolation, so the task is not used up." vertex="1">
          <mxGeometry height="68" width="330" x="485" y="980" as="geometry" />
        </mxCell>
        <mxCell id="e273" edge="1" parent="1" source="c272" style="endArrow=none;dashed=1;dashPattern=3 3;html=1;strokeColor=#d9b74a;entryX=0.4;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" target="c76" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c274" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d9b74a;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10.5;fontColor=#4b4b3c;fontFamily=Helvetica;" value="&lt;b style=&quot;color:#8a6a00&quot;&gt;COMPOSITE (one level)&lt;/b&gt;&lt;br&gt;A ComboMeal is a MenuItem made of two Dishes: price = 90% of their sum, units = sum. Callers never tell them apart." vertex="1">
          <mxGeometry height="68" width="310" x="1930" y="1575" as="geometry" />
        </mxCell>
        <mxCell id="e275" edge="1" parent="1" source="c274" style="endArrow=none;dashed=1;dashPattern=3 3;html=1;strokeColor=#d9b74a;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" target="c160" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c276" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d9b74a;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10.5;fontColor=#4b4b3c;fontFamily=Helvetica;" value="&lt;b style=&quot;color:#8a6a00&quot;&gt;STRATEGY (Stage 3)&lt;/b&gt;&lt;br&gt;New pricing rules plug in as PriceModifiers. VIP discount first, then Happy Hour." vertex="1">
          <mxGeometry height="68" width="205" x="2045" y="300" as="geometry" />
        </mxCell>
