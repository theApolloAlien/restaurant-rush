        <mxCell id="l266" connectable="0" parent="e265" style="edgeLabel;html=1;resizable=0;labelBackgroundColor=none;fontSize=10.5;fontStyle=1;fontColor=#111827;align=center;verticalAlign=middle;fontFamily=Helvetica;" value="0..*" vertex="1">
