        <mxCell id="e265" edge="1" parent="1" source="c160" style="startArrow=diamondThin;startFill=0;startSize=18;endArrow=none;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#4b5563;strokeWidth=1.2;exitX=0;exitY=0.7;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=10;fontStyle=2;fontColor=#4b5563;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" target="c156" value="components">
