        <mxCell id="l267" connectable="0" parent="e265" style="edgeLabel;html=1;resizable=0;labelBackgroundColor=none;fontSize=10.5;fontStyle=1;fontColor=#111827;align=center;verticalAlign=middle;fontFamily=Helvetica;" value="2" vertex="1">
          <mxGeometry relative="1" x="1" as="geometry">
