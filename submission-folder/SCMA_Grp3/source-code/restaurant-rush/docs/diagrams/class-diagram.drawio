ll><mxCell id="l262" value="1..*" style="edgeLabel;html=1;resizable=0;labelBackgroundColor=none;fontSize=10.5;fontStyle=1;fontColor=#111827;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" connectable="0" parent="e260"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="12.0" y="-11.0" as="offset"/></mxGeometry></mxCell><mxCell id="e263" value="" style="endArrow=block;endFill=0;endSize=14;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#4b5563;strokeWidth=1.2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=10;fontStyle=2;fontColor=#4b5563;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1" source="c156" target="c152"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1719.0" y="1402.5"/></Array></mxGeometry></mxCell><mxCell id="e264" value="" style="endArrow=block;endFill=0;endSize=14;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#4b5563;strokeWidth=1.2;exitX=0.3;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=10;fontStyle=2;fontColor=#4b5563;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1" source="c160" target="c152"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1977.3" y="1317.5"/></Array></mxGeometry></mxCell><mxCell id="e265" value="components" style="startArrow=diamondThin;startFill=0;startSize=18;endArrow=none;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#4b5563;strokeWidth=1.2;exitX=0;exitY=0.7;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=10;fontStyle=2;fontColor=#4b5563;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1" source="c160" target="c156"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1854.0" y="1510.0"/></Array></mxGeometry></mxCell><mxCell id="l266" value="0..*" style="edgeLabel;html=1;resizable=0;labelBackgroundColor=none;fontSize=10.5;fontStyle=1;fontColor=#111827;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" connectable="0" parent="e265"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="-14.0" y="-9.0" as="offset"/></mxGeometry></mxCell><mxCell id="l267" value="2" style="edgeLabel;html=1;resizable=0;labelBackgroundColor=none;fontSize=10.5;fontStyle=1;fontColor=#111827;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" connectable="0" parent="e265"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="14.0" y="-9.0" as="offset"/></mxGeometry></mxCell><mxCell id="c268" value="&lt;b style=&quot;color:#8a6a00&quot;&gt;POLYMORPHISM&lt;/b&gt;&lt;br&gt;Game never asks a customer&amp;#x27;s type. Loss rate, food choice, bill and paying remark are dispatched to the subclass (Stage 2)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d9b74a;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10.5;fontColor=#4b4b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290.0" y="1545.0" width="222.0" height="82.0" as="geometry"/></mxCell><mxCell id="e269" value="" style="endArrow=none;dashed=1;dashPattern=3 3;html=1;strokeColor=#d9b74a;entryX=0;entryY=0.4;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c268" target="c120"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c270" value="&lt;b style=&quot;color:#8a6a00&quot;&gt;ENCAPSULATION + COMPOSITION&lt;/b&gt;&lt;br&gt;Restaurant owns its tables and orders and is the only object that moves a customer between queue, table and door (the ~ methods). Its lists are handed out read-only." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d9b74a;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10.5;fontColor=#4b4b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="690.0" y="1272.0" width="310.0" height="82.0" as="geometry"/></mxCell><mxCell id="e271" value="" style="endArrow=none;dashed=1;dashPattern=3 3;html=1;strokeColor=#d9b74a;entryX=1;entryY=0.85;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c270" target="c112"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c272" value="&lt;b style=&quot;color:#8a6a00&quot;&gt;TEMPLATE METHOD&lt;/b&gt;&lt;br&gt;perform() checks the task budget and duty, then calls carryOut(). A broken rule throws RuleViolation, so the task is not used up." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d9b74a;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10.5;fontColor=#4b4b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="485.0" y="980.0" width="330.0" height="68.0" as="geometry"/></mxCell><mxCell id="e273" value="" style="endArrow=none;dashed=1;dashPattern=3 3;html=1;strokeColor=#d9b74a;entryX=0.4;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c272" target="c76"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c274" value="&lt;b style=&quot;color:#8a6a00&quot;&gt;COMPOSITE (one level)&lt;/b&gt;&lt;br&gt;A ComboMeal is a MenuItem made of two Dishes: price = 90% of their sum, units = sum. Callers never tell them apart." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d9b74a;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10.5;fontColor=#4b4b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1930.0" y="1575.0" width="310.0" height="68.0" as="geometry"/></mxCell><mxCell id="e275" value="" style="endArrow=none;dashed=1;dashPattern=3 3;html=1;strokeColor=#d9b74a;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c274" target="c160"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c276" value="&lt;b style=&quot;color:#8a6a00&quot;&gt;STRATEGY (Stage 3)&lt;/b&gt;&lt;br&gt;New pricing rules plug in as PriceModifiers. VIP discount first, then Happy Hour." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#d9b74a;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10.5;fontColor=#4b4b3c;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2045.0" y="300.0" width="205.0" height="68.0" as="geometry"/></mxCell><mxCell id="e277" value="" style="endArrow=none;dashed=1;dashPattern=3 3;html=1;strokeColor=#d9b74a;entryX=1;entryY=0.3;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c276" target="c68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c278" value="Visibility: + public &amp;nbsp; - private &amp;nbsp; # protected &amp;nbsp; ~ package. Italic = abstract, underlined = static." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6b7280;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1650.0" y="1850.0" width="560.0" height="16.0" as="geometry"/></mxCell><mxCell id="e279" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#4b5563;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1650.0" y="1880.0" as="sourcePoint"/><mxPoint x="1702.0" y="1880.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c280" value="generalisation" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1710.0" y="1872.0" width="130.0" height="16.0" as="geometry"/></mxCell><mxCell id="e281" value="" style="endArrow=block;endFill=0;endSize=14;dashed=1;html=1;strokeColor=#4b5563;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1845.0" y="1880.0" as="sourcePoint"/><mxPoint x="1897.0" y="1880.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c282" value="realisation" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1905.0" y="1872.0" width="130.0" height="16.0" as="geometry"/></mxCell><mxCell id="e283" value="" style="startArrow=diamondThin;startFill=1;startSize=18;endArrow=none;html=1;strokeColor=#4b5563;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2040.0" y="1880.0" as="sourcePoint"/><mxPoint x="2092.0" y="1880.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c284" value="composition" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2100.0" y="1872.0" width="130.0" height="16.0" as="geometry"/></mxCell><mxCell id="e285" value="" style="startArrow=diamondThin;startFill=0;startSize=18;endArrow=none;html=1;strokeColor=#4b5563;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1650.0" y="1902.0" as="sourcePoint"/><mxPoint x="1702.0" y="1902.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c286" value="aggregation" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1710.0" y="1894.0" width="130.0" height="16.0" as="geometry"/></mxCell><mxCell id="e287" value="" style="endArrow=open;endSize=10;html=1;strokeColor=#4b5563;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1845.0" y="1902.0" as="sourcePoint"/><mxPoint x="1897.0" y="1902.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c288" value="association" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1905.0" y="1894.0" width="130.0" height="16.0" as="geometry"/></mxCell><mxCell id="e289" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeColor=#4b5563;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2040.0" y="1902.0" as="sourcePoint"/><mxPoint x="2092.0" y="1902.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c290" value="dependency" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2100.0" y="1894.0" width="130.0" height="16.0" as="geometry"/></mxCell><mxCell id="e291" value="" style="endArrow=none;html=1;strokeColor=#4b5563;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1650.0" y="1924.0" as="sourcePoint"/><mxPoint x="1702.0" y="1924.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c292" value="association, both ways" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1710.0" y="1916.0" width="130.0" height="16.0" as="geometry"/></mxCell><mxCell id="c293" value="«record» components are shown as + read-only properties: Java gives each a private final field&lt;br&gt;and a public accessor. Getters, toString(), most constructors and most private helpers are left out.&lt;br&gt;Nested types used as member types: ArrivalSchedule.Arrival «record», ArrivalSchedule.CustomerFactory&lt;br&gt;«interface», GameResult.Target «record», Cashier.Payment «record», CommandParser.Input «record»." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#6b7280;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="1850.0" width="540.0" height="64.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
